# Variables de entorno de la aplicación. No hay credenciales: copia este archivo a `.env.local`
# solo si necesitas cambiar un valor. Los archivos `.env*` reales están en .gitignore.

# Activa los ganchos de demostración (?fallo=1, ?perder=1 y DELETE /api/sync/inspections).
# APAGADOS por omisión (mínimo privilegio). Las pruebas E2E la activan por su cuenta.
ENABLE_DEMO_HOOKS=0

# Añade `upgrade-insecure-requests` a la CSP. Actívala SOLO detrás de HTTPS; en http://localhost
# no tiene sentido.
ENFORCE_HTTPS_UPGRADE=0
